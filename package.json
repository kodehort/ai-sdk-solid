{
  "name": "@kodehort/ai-sdk-solid",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kodehort/ai-sdk-solid"
  },
  "homepage": "https://github.com/kodehort/ai-sdk-solid#readme",
  "bugs": {
    "url": "https://github.com/kodehort/ai-sdk-solid/issues"
  },
  "description": "A SolidJS provider for the AI SDK, hooks for @ai-sdk",
  "keywords": [
    "typescript",
    "javascript",
    "solidjs",
    "ai-sdk",
    "ai-sdk-solid",
    "solidjs-hooks"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "test": "NODE_OPTIONS='--no-warnings' vitest --run",
    "test:watch": "NODE_OPTIONS='--no-warnings' vitest",
    "typecheck": "tsc --noEmit",
    "format": "bunx -b ultracite@latest fix",
    "lint": "bunx -b ultracite@latest check"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "^4.0.2",
    "ai": "^6.0.5",
    "throttleit": "2.1.0"
  },
  "devDependencies": {
    "@ai-sdk/test-server": "^1.0.1",
    "@biomejs/biome": "2.3.11",
    "@semantic-release/github": "^12.0.2",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.0",
    "jsdom": "^27.4.0",
    "msw": "^2.12.7",
    "semantic-release": "^25.0.2",
    "solid-js": "^1.9.7",
    "tsup": "^8.5.0",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "5.9.3",
    "ultracite": "7.0.5",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^4.0.16",
    "zod": "^4.3.4"
  },
  "peerDependencies": {
    "solid-js": "^1.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
