{
  "name": "ai-solid",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "dev": "tsup --watch",
    "lint": "eslint \"./**/*.ts*\"",
    "test": "vitest --run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "^3.0.0-beta.11",
    "ai": "^5.0.0-beta.11",
    "throttleit": "2.1.0"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "jsdom": "^27.2.0",
    "msw": "^2.12.4",
    "solid-js": "^1.9.7",
    "tsup": "^8.5.0",
    "tsup-preset-solid": "^2.2.0",
    "typescript": "5.9.3",
    "vite-plugin-solid": "^2.11.6",
    "vitest": "^4.0.15",
    "zod": "^4.1.13"
  },
  "peerDependencies": {
    "solid-js": "^1.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
